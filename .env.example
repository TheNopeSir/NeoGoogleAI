# Server
PORT=3002

# PostgreSQL Database
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Set to 'false' only if using self-signed certificates (not recommended for production)
DB_SSL_REJECT_UNAUTHORIZED=true

# EmailJS (https://www.emailjs.com)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_WELCOME=template_xxxxxxx
EMAILJS_TEMPLATE_RESET=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# S3 / Object Storage
S3_ENDPOINT=https://s3.your-provider.ru
S3_REGION=ru-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET_NAME=your_bucket_name
S3_PUBLIC_URL=https://your_bucket_public_url

# VAPID Keys for Web Push (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.ru,https://www.yourdomain.ru

# App URL (used in email verification links)
APP_URL=https://yourdomain.ru

# Admin credentials (override defaults — keep in sync with DB)
ADMIN_USERNAME=YourAdminUsername
ADMIN_EMAIL=admin@yourdomain.ru

# Admin API key — required to access /api/admin/* endpoints
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your_strong_random_admin_api_key

# Telegram Bot Token — required for Telegram login signature verification
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Telegram Bot username (without @) — enables Telegram login button on the frontend
VITE_TELEGRAM_BOT_NAME=your_bot_username
